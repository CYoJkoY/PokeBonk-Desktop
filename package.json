{
  "name": "pokebonk-desktop",
  "productName": "PokéBonk",
  "version": "1.5.2",
  "packageManager": "bun@1.4.4",
  "engines": { "node": "26.13.1", "bun": "1.4.4" },
  "trustedDependencies": ["electron"],
  "description": "Cliente de escritorio de PokéBonk (fan-game no oficial, gratuito y sin ánimo de lucro).",
  "author": "Charcher",
  "homepage": "https://pokebonk.com",
  "license": "UNLICENSED",
  "private": true,
  "main": "out/main.js",
  "desktopName": "pokebonk.desktop",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "verify": "bun run check && bun test",
    "smoke": "bun run build && node scripts/smoke.mjs",
    "verify:package": "node scripts/check-package.mjs",
    "verify:vulkan": "bun run build && node scripts/check-vulkan.mjs",
    "start": "bun run build && electron .",
    "dev": "bun run build && electron . --url=http://localhost:5173 --devtools",
    "selftest": "bun run build && electron . --selftest=out/selftest",
    "dist:win": "bun run build && electron-builder --win",
    "dist:mac": "bun run build && electron-builder --mac -c.productName=PokeBonk",
    "dist:linux": "bun run build && electron-builder --linux",
    "dist:linux:docker": "npm run build && docker run --rm -v \"%INIT_CWD%:/project\" -v /project/node_modules -w /project electronuserland/builder:22 bash -c \"npm ci --no-audit --no-fund && npx electron-builder --linux -c.directories.output=/tmp/rel && cp /tmp/rel/*.AppImage /tmp/rel/*.deb /project/release/\"",
    "sync:repo": "node sync-repo.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "44.7.1",
    "electron-builder": "26.17.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "electron-updater": "6.8.11"
  }
}
